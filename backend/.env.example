DATABASE_URL="postgresql://gopass:gopass@localhost:5435/gopass"
JWT_SECRET="change-me-in-local-env"
JWT_EXPIRES_IN="1d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Optional: bootstraps an ADMIN user via `npm run prisma:seed` (or `prisma db seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_NAME="Admin"
